{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "profile",
    "required_scenarios",
    "manifest_digest"
  ],
  "properties": {
    "profile_version": {
      "const": "agent-tool-auth-conformance/profile-v0"
    },
    "profile": {
      "enum": [
        "decision-only",
        "mediated-dispatch",
        "owned-effect-sink"
      ]
    },
    "required_scenarios": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "manifest_digest": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile": {
            "const": "decision-only"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "required_scenarios": {
            "const": [
              "AUTH-001-D",
              "AUTH-002-D",
              "AUTH-003-D",
              "AUTH-004-D",
              "AUTH-010-D"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "mediated-dispatch"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "required_scenarios": {
            "const": [
              "AUTH-001",
              "AUTH-002",
              "AUTH-003",
              "AUTH-004",
              "AUTH-009",
              "AUTH-010"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "profile": {
            "const": "owned-effect-sink"
          }
        },
        "required": [
          "profile"
        ]
      },
      "then": {
        "properties": {
          "required_scenarios": {
            "const": [
              "AUTH-001",
              "AUTH-002",
              "AUTH-003",
              "AUTH-004",
              "AUTH-005",
              "AUTH-007",
              "AUTH-009",
              "AUTH-010"
            ]
          }
        }
      }
    }
  ]
}
