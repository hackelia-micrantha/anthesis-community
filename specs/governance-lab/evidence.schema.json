{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthesis.example/specs/governance-lab/evidence.schema.json",
  "title": "Anthesis Governance Lab Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scenario_id",
    "decision",
    "decision_source",
    "policy",
    "policy_digest",
    "canonicalization",
    "reason",
    "effect",
    "engine",
    "previous_record_digest",
    "record_digest"
  ],
  "properties": {
    "version": { "const": "anthesis.evidence/v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["allow", "deny", "approval_required"]
    },
    "decision_source": {
      "type": "string",
      "enum": ["policy_rule", "policy_default", "engine_guard"]
    },
    "policy": { "type": "string", "minLength": 1 },
    "policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canonicalization": { "const": "rfc8785-json" },
    "policy_rule_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "effect": { "$ref": "decision.schema.json#/$defs/effect" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "anthesis-lab" },
        "version": { "type": "string", "minLength": 1 },
        "binary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "configured_runtime": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "previous_record_digest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "record_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision_source": { "const": "policy_rule" } },
        "required": ["decision_source"]
      },
      "then": { "required": ["policy_rule_id"] }
    },
    {
      "if": {
        "properties": { "decision_source": { "const": "policy_default" } },
        "required": ["decision_source"]
      },
      "then": {
        "properties": { "policy_rule_id": { "const": "default" } },
        "required": ["policy_rule_id"]
      }
    },
    {
      "if": {
        "properties": { "decision_source": { "const": "engine_guard" } },
        "required": ["decision_source"]
      },
      "then": {
        "properties": { "decision": { "const": "deny" } }
      }
    }
  ]
}
