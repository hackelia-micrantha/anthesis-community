{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthesis.example/specs/governance-lab/evidence.schema.json",
  "title": "Anthesis Governance Lab Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scenario_id",
    "decision",
    "policy",
    "policy_digest",
    "policy_rule_id",
    "reason",
    "effect",
    "engine",
    "previous_record_digest",
    "record_digest"
  ],
  "properties": {
    "version": { "const": "anthesis.evidence/v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "string",
      "enum": ["allow", "deny", "approval_required"]
    },
    "policy": { "type": "string", "minLength": 1 },
    "policy_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "policy_rule_id": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "effect": { "$ref": "decision.schema.json#/$defs/effect" },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "anthesis-lab" },
        "version": { "type": "string", "minLength": 1 },
        "binary_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "run_id": { "type": "string", "minLength": 1 },
    "previous_record_digest": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "record_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "key_id": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
