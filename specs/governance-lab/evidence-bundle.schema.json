{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthesis.example/specs/governance-lab/evidence-bundle.schema.json",
  "title": "Anthesis Governance Lab Evidence Bundle Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "bundle_id",
    "run_id",
    "replayability_class",
    "comparison_strategy",
    "decision_path",
    "report_path",
    "entries",
    "links"
  ],
  "properties": {
    "version": { "const": "anthesis.evidence-bundle/v1" },
    "bundle_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "replayability_class": { "enum": ["none", "bounded", "strong"] },
    "comparison_strategy": {
      "enum": ["strict", "semantic", "governance", "non_replayable"]
    },
    "decision_path": { "$ref": "#/$defs/path" },
    "report_path": { "$ref": "#/$defs/path" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    },
    "links": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/link" }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\\\\\u0000]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "role": {
          "enum": [
            "scenario",
            "policy",
            "runtime_profile",
            "decision",
            "report",
            "artifact"
          ]
        },
        "sha256": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "relation", "target_path", "target_sha256"],
      "properties": {
        "source_path": { "$ref": "#/$defs/path" },
        "relation": { "enum": ["reports_on", "derived_from", "references"] },
        "target_path": { "$ref": "#/$defs/path" },
        "target_sha256": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
