{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthesis.example/specs/governance-lab/scenario.schema.json",
  "title": "Anthesis Governance Lab Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "goal",
    "policy",
    "actor",
    "runtime",
    "attempts",
    "expected"
  ],
  "properties": {
    "version": { "const": "anthesis.scenario/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "goal": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["local_scenario"] }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": {
        "role": { "type": "string", "minLength": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "source", "reason", "evidence"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["allow", "deny", "approval_required"]
        },
        "source": {
          "type": "string",
          "enum": ["policy_rule", "policy_default", "engine_guard"]
        },
        "rule_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": { "const": "policy_rule" }
            },
            "required": ["source"]
          },
          "then": { "required": ["rule_id"] }
        },
        {
          "if": {
            "properties": {
              "source": { "const": "policy_default" }
            },
            "required": ["source"]
          },
          "then": {
            "properties": { "rule_id": { "const": "default" } },
            "required": ["rule_id"]
          }
        }
      ]
    }
  },
  "$defs": {
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "action": { "enum": ["file.read", "file.write", "file.delete"] }
            },
            "required": ["action"]
          },
          "then": { "required": ["path"] }
        },
        {
          "if": {
            "properties": { "action": { "const": "command.run" } },
            "required": ["action"]
          },
          "then": { "required": ["command"] }
        }
      ]
    }
  }
}
