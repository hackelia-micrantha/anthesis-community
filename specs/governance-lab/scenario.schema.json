{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthesis.example/specs/governance-lab/scenario.schema.json",
  "title": "Anthesis Governance Lab Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "goal", "policy", "actor", "runtime", "request_binding", "attempts", "expected"],
  "properties": {
    "version": { "const": "anthesis.scenario/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "goal": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "local_scenario" } }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role"],
      "properties": { "role": { "type": "string", "minLength": 1 } }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "request_binding": { "$ref": "#/$defs/requestBinding" },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": { "$ref": "#/$defs/attempt" }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "source", "reason", "evidence"],
      "properties": {
        "decision": { "enum": ["allow", "deny", "approval_required"] },
        "source": { "enum": ["policy_rule", "policy_default", "engine_guard"] },
        "rule_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "source": { "const": "policy_rule" } }, "required": ["source"] },
          "then": { "required": ["rule_id"] }
        },
        {
          "if": { "properties": { "source": { "const": "policy_default" } }, "required": ["source"] },
          "then": { "properties": { "rule_id": { "const": "default" } }, "required": ["rule_id"] }
        },
        {
          "if": { "properties": { "source": { "const": "engine_guard" } }, "required": ["source"] },
          "then": {
            "properties": { "decision": { "const": "deny" } },
            "not": { "required": ["rule_id"] }
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "requestBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "canonicalization",
        "algorithm",
        "input_digest",
        "plan_digest",
        "source_digest",
        "dependency_state_digest"
      ],
      "properties": {
        "version": { "const": "anthesis.request-binding/v1" },
        "canonicalization": { "const": "rfc8785-json" },
        "algorithm": { "const": "sha256" },
        "input_digest": { "$ref": "#/$defs/digest" },
        "plan_digest": { "$ref": "#/$defs/digest" },
        "source_digest": { "$ref": "#/$defs/digest" },
        "dependency_state_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "attempt": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "path"],
          "properties": {
            "action": { "enum": ["file.read", "file.write", "file.delete"] },
            "path": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "command"],
          "properties": {
            "action": { "enum": ["command.run", "network.request"] },
            "command": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {
            "action": { "enum": ["git.status", "git.diff", "rg.search", "release.tag", "deploy.run", "git.merge"] }
          }
        }
      ]
    }
  }
}
