{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthesis.example/specs/governance-lab/scenario.schema.json",
  "title": "Anthesis Governance Lab Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "expected_outcome",
    "goal",
    "role",
    "agent_runtime",
    "policy",
    "expected_evidence"
  ],
  "properties": {
    "version": { "const": "anthesis.scenario/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,127}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "expected_outcome": {
      "type": "string",
      "enum": ["allow", "deny", "approval_required"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "enum": ["local_scenario"] }
      }
    },
    "goal": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "agent_runtime": { "type": "string", "minLength": 1 },
    "policy": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "fault_injection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "unauthorized_path_write",
            "network_access",
            "secret_access",
            "dependency_change",
            "unknown_runtime",
            "evidence_tamper"
          ]
        },
        "attempted_path": { "type": "string", "minLength": 1 },
        "attempted_command": { "type": "string", "minLength": 1 },
        "attempted_runtime": { "type": "string", "minLength": 1 },
        "expected_reason": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "unauthorized_path_write",
                  "secret_access",
                  "dependency_change",
                  "evidence_tamper"
                ]
              }
            }
          },
          "then": { "required": ["attempted_path"] }
        },
        {
          "if": { "properties": { "type": { "const": "network_access" } } },
          "then": { "required": ["attempted_command"] }
        },
        {
          "if": { "properties": { "type": { "const": "unknown_runtime" } } },
          "then": { "required": ["attempted_runtime"] }
        }
      ]
    },
    "expected_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
