{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anthesis.example/specs/governance-lab/runtime-profile.schema.json",
  "title": "Anthesis Governance Lab Runtime Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "allowed_runtimes"],
  "properties": {
    "version": { "const": "anthesis.lab-profile/v1" },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "allowed_runtimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
